# Server & Database Configuration
PORT=5000
MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/samrat_fashion
TEST_MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/samrat_fashion_test_isolated
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx

# Frontend & Backend Endpoints
NEXT_PUBLIC_API_URL=http://localhost:5000/api
FRONTEND_URL=http://localhost:3000
# Public canonical site URL used by sitemap, robots.txt and share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Extra browser origins allowed by the cookie/CSRF guard (comma-separated).
# Set this when you serve the frontend from both apex and www domains.
ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth Configuration (Sign In with Google / Continue with Google)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Cloudflare Turnstile CAPTCHA (registration and forgot password)
# Set TURNSTILE_ENABLED=true in production. The secret key stays on the backend;
# the site key is public and baked into the frontend at build time.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
# Emergency escape hatch: set to true only to fail open if Cloudflare is down.
TURNSTILE_FAIL_OPEN=false

# Logistics & Courier Integration (Phase 10B - Delhivery)
# Options: 'delhivery' (for real courier integration) or 'mock' (for development)
LOGISTICS_PROVIDER=delhivery
ALLOW_LOGISTICS_MOCK=true

# Delhivery API Credentials (Required when LOGISTICS_PROVIDER=delhivery)
DELHIVERY_ENV=sandbox
DELHIVERY_API_TOKEN=your_delhivery_api_token_here
DELHIVERY_CLIENT_NAME=SAMRAT FASHION
DELHIVERY_PICKUP_LOCATION=Primary Warehouse
DELHIVERY_WEBHOOK_SECRET=delhivery_webhook_secret_key
ORIGIN_POSTAL_CODE=400001

# Customer Email & Notification Infrastructure
# Options:
#   'brevo'   - Brevo Transactional API (requires API key from Brevo dashboard starting with xkeysib-)
#   'smtp'    - Standard SMTP via Nodemailer (supports Brevo SMTP relay, Mailgun, SendGrid, custom SMTP)
#   'gmail'   - Gmail via Nodemailer (requires Gmail App Password)
#   'console' - Logs full email and verification OTP/links to terminal console (ideal for local development)
EMAIL_PROVIDER=brevo
# Allows console-only mail when the selected provider is not configured; it does not replace failed real sends.
ALLOW_EMAIL_MOCK=true

# Brevo Credentials (Required when EMAIL_PROVIDER=brevo)
# Use an API key (starts with xkeysib-) for the Brevo API.
# SMTP keys (starts with xsmtpsib-) use Brevo SMTP and require SMTP_USER to be the Brevo SMTP login.
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM=no-reply@samratfashion.com
EMAIL_FROM_NAME=Samrat Fashion

# SMTP Configuration (Optional alternative when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_login@example.com
SMTP_PASS=your_smtp_password
SMTP_SECURE=false

# Gmail Configuration (Optional alternative when EMAIL_PROVIDER=gmail)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
# Image Storage & CDN Infrastructure (Phase 13A - Cloudinary)
# Options: 'cloudinary' (for CDN delivery) or 'local' (for development/testing)
IMAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Analytics & Measurement (Phase 12C - GA4)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX


# Custom Design / Custom Printing Feature Gate
# Default false for production launch; enable only when the deferred custom design stack is released.
ENABLE_CUSTOM_DESIGN=false

# Frontend feature visibility (must mirror ENABLE_CUSTOM_DESIGN)
NEXT_PUBLIC_ENABLE_CUSTOM_DESIGN=false
