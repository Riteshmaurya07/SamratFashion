import mongoose from "mongoose";
import { MongoMemoryServer } from "mongodb-memory-server";
import { CustomDesign } from "../models/CustomDesign";
import { CustomDesignController } from "../controllers/customDesignController";
import { createCustomDesignSchema } from "../utils/customDesignValidation";

describe("Phase 3 Hardening: Custom Design Validation & Concurrency", () => {
  let mongoServer: MongoMemoryServer;

  beforeAll(async () => {
    mongoServer = await MongoMemoryServer.create();
    const uri = mongoServer.getUri();
    await mongoose.connect(uri);
  });

  afterAll(async () => {
    await mongoose.disconnect();
    await mongoServer.stop();
  });

  afterEach(async () => {
    await CustomDesign.deleteMany({});
  });

  describe("5. Printable-Zone Security", () => {
    it("should reject elements placed outside the allowed printable boundaries", () => {
      const payload = {
        name: "Out of Bounds Test",
        productId: new mongoose.Types.ObjectId().toHexString(),
        selectedVariantId: new mongoose.Types.ObjectId().toHexString(),
        selectedColor: "Black",
        design: {
          front: {
            elements: [
              {
                id: "el1",
                type: "TEXT",
                x: 1500, // Invalid: > 600
                y: 100,
                width: 100,
                height: 50,
              }
            ]
          }
        }
      };

      const result = createCustomDesignSchema.safeParse(payload);
      expect(result.success).toBe(false);
      if (!result.success) {
        const errorMsg = result.error.errors[0].message;
        expect(errorMsg).toContain("Element out of printable bounds");
      }
    });

    it("should accept valid elements within printable boundaries", () => {
      const payload = {
        name: "Valid Bounds Test",
        productId: new mongoose.Types.ObjectId().toHexString(),
        selectedVariantId: new mongoose.Types.ObjectId().toHexString(),
        selectedColor: "Black",
        design: {
          front: {
            elements: [
              {
                id: "el1",
                type: "TEXT",
                x: 200,
                y: 300,
                width: 100,
                height: 50,
              }
            ]
          }
        }
      };

      const result = createCustomDesignSchema.safeParse(payload);
      expect(result.success).toBe(true);
    });
  });

  describe("6. Save / Version Test (Concurrency 409)", () => {
    it("should reject updates with a stale version number and preserve immutable versions", async () => {
      const userId = new mongoose.Types.ObjectId().toHexString();
      const productId = new mongoose.Types.ObjectId().toHexString();

      // Create Version 1
      const design = await CustomDesign.create({
        userId,
        productId,
        status: "DRAFT",
        design: { front: { elements: [] } },
        versions: [{
          version: 1,
          design: { front: { elements: [] } },
          createdAt: new Date(),
          createdBy: userId
        }],
        currentVersion: 1
      });

      // User A loads version 1
      const userAVersion = design.currentVersion;

      // User B updates design (bumps to version 2)
      await CustomDesign.findOneAndUpdate(
        { _id: design._id, currentVersion: userAVersion },
        { 
          $set: { "design.front.elements": [{ id: "fromUserB" }] },
          $inc: { currentVersion: 1 },
          $push: { versions: { version: userAVersion + 1, design: { front: { elements: [{ id: "fromUserB" }] } }, createdBy: userId } }
        },
        { new: true }
      );

      // User A attempts to save their old state (using userAVersion = 1)
      const userAUpdate = await CustomDesign.findOneAndUpdate(
        { _id: design._id, currentVersion: userAVersion },
        { 
          $set: { "design.front.elements": [{ id: "fromUserA" }] },
          $inc: { currentVersion: 1 }
        },
        { new: true }
      );

      // Must return null (simulating 409 Conflict)
      expect(userAUpdate).toBeNull();

      // Verify DB state: currentVersion = 2, versions[0] is untouched.
      const finalDoc = await CustomDesign.findById(design._id);
      expect(finalDoc?.currentVersion).toBe(2);
      expect(finalDoc?.versions.length).toBe(2);
      expect(finalDoc?.versions[0].version).toBe(1);
    });
  });
});
